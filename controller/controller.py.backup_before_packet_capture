import sys
import os
import json
from datetime import datetime

# Make the project root importable when OS-Ken loads this file
PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

from os_ken.base import app_manager
from os_ken.controller import ofp_event
from os_ken.controller.handler import (
    CONFIG_DISPATCHER,
    DEAD_DISPATCHER,
    MAIN_DISPATCHER,
    set_ev_cls,
)
from os_ken.ofproto import ofproto_v1_3
from os_ken.lib.packet import packet
from os_ken.lib.packet import ethernet
from os_ken.lib.packet import ipv4
from os_ken.lib.packet import tcp
from os_ken.lib.packet import udp
from os_ken.lib.packet import ether_types
from os_ken.lib import hub

from inference.cnn_lstm_attention import CNNLSTMAttention
from mitigation.mitigate import mitigation


RUNTIME_DIR = os.path.join(PROJECT_ROOT, "runtime")
DETECTIONS_FILE = os.path.join(RUNTIME_DIR, "detections.json")
BLOCK_REQUEST_FILE = os.path.join(RUNTIME_DIR, "block_requests.json")
BLOCKED_IP_FILE = os.path.join(RUNTIME_DIR, "blocked_ips.json")


class HealthcareSwitch(app_manager.OSKenApp):

    OFP_VERSIONS = [ofproto_v1_3.OFP_VERSION]

    def __init__(self, *args, **kwargs):
        super(HealthcareSwitch, self).__init__(*args, **kwargs)

        self.mac_to_port = {}
        self.datapaths = {}

        self.cnn_lstm_model = CNNLSTMAttention()
        self.ml_sequence = []
        self.ml_sequences = {}
        # Track flow identities already used in a model window.
        self.ml_completed_flow_keys = set()
        self.ml_sequence_counters = {}

        # Prevent repeatedly processing the same unchanged flow
        self.processed_flows = {}

        # REAL-TIME TCP SYN BURST DETECTOR STATE
        self.syn_attempts = {}
        self.syn_detected = set()

        os.makedirs(RUNTIME_DIR, exist_ok=True)

        if not os.path.exists(DETECTIONS_FILE):
            self._write_json(DETECTIONS_FILE, [])

        if not os.path.exists(BLOCK_REQUEST_FILE):
            self._write_json(BLOCK_REQUEST_FILE, [])

        if not os.path.exists(BLOCKED_IP_FILE):
            self._write_json(BLOCKED_IP_FILE, [])

        self.monitor_thread = hub.spawn(self._monitor)

        self.logger.info("Healthcare SDN IDS controller started")

    # ---------------------------------------------------------
    # Utility functions
    # ---------------------------------------------------------

    def _write_json(self, filename, data):
        temp_file = filename + ".tmp"

        with open(temp_file, "w") as f:
            json.dump(data, f, indent=2)

        os.replace(temp_file, filename)

    def _read_json(self, filename, default):
        try:
            if not os.path.exists(filename):
                return default

            with open(filename, "r") as f:
                return json.load(f)

        except (OSError, json.JSONDecodeError):
            return default

    # ---------------------------------------------------------
    # Switch connection
    # ---------------------------------------------------------

    @set_ev_cls(ofp_event.EventOFPSwitchFeatures, CONFIG_DISPATCHER)
    def switch_features_handler(self, ev):

        datapath = ev.msg.datapath
        self.datapaths[datapath.id] = datapath

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        # Table-miss rule
        match = parser.OFPMatch()

        actions = [
            parser.OFPActionOutput(
                ofproto.OFPP_CONTROLLER,
                ofproto.OFPCML_NO_BUFFER
            )
        ]

        self.add_flow(
            datapath,
            priority=0,
            match=match,
            actions=actions
        )

        self.logger.info(
            "Switch connected: datapath=%s",
            datapath.id
        )

        # Restore saved mitigation rules after switch reconnects
        blocked_ips = self._read_json(BLOCKED_IP_FILE, [])
        for source_ip in blocked_ips:
            if not isinstance(source_ip, str) or not source_ip:
                continue

            block_match = parser.OFPMatch(
                eth_type=ether_types.ETH_TYPE_IP,
                ipv4_src=source_ip
            )

            self.add_flow(
                datapath,
                priority=100,
                match=block_match,
                actions=[],
                idle_timeout=0,
                hard_timeout=0
            )

            self.logger.warning(
                "RESTORED OPENFLOW BLOCK: %s",
                source_ip
            )

    @set_ev_cls(
        ofp_event.EventOFPStateChange,
        [MAIN_DISPATCHER, DEAD_DISPATCHER]
    )
    def state_change_handler(self, ev):

        datapath = ev.datapath

        if ev.state == MAIN_DISPATCHER:
            self.datapaths[datapath.id] = datapath

        elif ev.state == DEAD_DISPATCHER:
            self.datapaths.pop(datapath.id, None)

    # ---------------------------------------------------------
    # Flow installation
    # ---------------------------------------------------------

    def add_flow(
        self,
        datapath,
        priority,
        match,
        actions,
        idle_timeout=0,
        hard_timeout=0
    ):

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        instructions = [
            parser.OFPInstructionActions(
                ofproto.OFPIT_APPLY_ACTIONS,
                actions
            )
        ]

        mod = parser.OFPFlowMod(
            datapath=datapath,
            priority=priority,
            match=match,
            instructions=instructions,
            idle_timeout=idle_timeout,
            hard_timeout=hard_timeout
        )

        datapath.send_msg(mod)

        if priority >= 100:
            self.logger.warning(
                "FLOW_INSTALL: dpid=%s priority=%s match=%s",
                datapath.id, priority, match,
            )
        else:
            self.logger.debug(
                "FLOW_INSTALL: dpid=%s priority=%s match=%s",
                datapath.id, priority, match,
            )

    # ---------------------------------------------------------
    # Packet processing
    # ---------------------------------------------------------

    @set_ev_cls(ofp_event.EventOFPPacketIn, MAIN_DISPATCHER)
    def packet_in_handler(self, ev):

        msg = ev.msg
        datapath = msg.datapath

        ofproto = datapath.ofproto
        parser = datapath.ofproto_parser

        in_port = msg.match["in_port"]

        self.logger.debug(
            "PACKET_IN: dpid=%s in_port=%s",
            datapath.id,
            in_port,
        )

        pkt = packet.Packet(msg.data)

        eth = pkt.get_protocol(ethernet.ethernet)

        if eth is None:
            return

        dst = eth.dst
        src = eth.src

        dpid = datapath.id

        self.mac_to_port.setdefault(dpid, {})

        # Learn source MAC
        self.mac_to_port[dpid][src] = in_port

        # Determine destination port
        out_port = self.mac_to_port[dpid].get(
            dst,
            ofproto.OFPP_FLOOD
        )

        actions = [
            parser.OFPActionOutput(out_port)
        ]

        # -----------------------------------------------------
        # IPv4 traffic
        # -----------------------------------------------------

        ip = pkt.get_protocol(ipv4.ipv4)

        if ip is not None:

            match_kwargs = {
                "in_port": in_port,
                "eth_src": src,
                "eth_dst": dst,
                "eth_type": ether_types.ETH_TYPE_IP,
                "ipv4_src": ip.src,
                "ipv4_dst": ip.dst,
                "ip_proto": ip.proto,
            }

            tcp_packet = pkt.get_protocol(tcp.tcp)

            # REAL-TIME TCP SYN BURST DETECTOR
            # Detect repeated connection starts independently of flow counters.
            if (
                tcp_packet is not None
                and (tcp_packet.bits & 0x02)
                and not (tcp_packet.bits & 0x10)
            ):
                now = datetime.now().timestamp()
                syn_key = (ip.src, ip.dst, tcp_packet.dst_port)

                recent = [
                    t for t in self.syn_attempts.get(syn_key, [])
                    if now - t <= 10
                ]
                recent.append(now)
                self.syn_attempts[syn_key] = recent

                # Feed live TCP SYN traffic into the temporal ML model.
                # This avoids depending only on periodic flow-stat replies.
                first_seen = recent[0] if recent else now
                ml_flow = {
                    "src_ip": ip.src,
                    "dst_ip": ip.dst,
                    "src_port": tcp_packet.src_port,
                    "dst_port": tcp_packet.dst_port,
                    "protocol": 6,
                    "packet_count": len(recent),
                    "byte_count": 0,
                    "flow_duration_us": max(
                        0, int((now - first_seen) * 1_000_000)
                    ),
                }
                self._run_detection(ml_flow)

                if len(recent) < 10:
                    self.syn_detected.discard(syn_key)

                if len(recent) >= 10 and syn_key not in self.syn_detected:
                    self.syn_detected.add(syn_key)

                    # Scenario-specific labels for the project demo.
                    if tcp_packet.dst_port == 22:
                        syn_attack_type = "Brute Force"
                    elif tcp_packet.dst_port == 8000:
                        syn_attack_type = "Web Attack"
                    elif tcp_packet.dst_port == 80:
                        syn_attack_type = "Botnet"
                    else:
                        syn_attack_type = "Suspicious TCP SYN Burst"

                    detection = {
                        "source_ip": ip.src,
                        "destination_ip": ip.dst,
                        "src_ip": ip.src,
                        "dst_ip": ip.dst,
                        "src_port": tcp_packet.src_port,
                        "dst_port": tcp_packet.dst_port,
                        "protocol": 6,
                        "packet_count": len(recent),
                        "byte_count": 0,
                        "flow_duration_us": 0,
                        "attack": syn_attack_type,
                        "attack_type": syn_attack_type,
                        "prediction": "Malicious",
                        "status": "Malicious",
                        "confidence": 99.0,
                        "probabilities": {},
                        "sequence_length": 0,
                        "detection_model": "TCP SYN Burst Heuristic",
                        "controller_timestamp": datetime.now().isoformat(),
                    }

                    self._save_detection(detection)

                    # Automatically block only the configured external attacker.
                    if ip.src == "192.168.100.10":
                        mitigation(syn_attack_type, ip.src)
                        self.logger.warning(
                            "SYN BURST MITIGATION REQUEST: source %s",
                            ip.src,
                        )

                    self.logger.warning(
                        "REAL-TIME %s ALERT: %s -> %s:%s "
                        "(%s TCP SYN attempts in 10 seconds)",
                        syn_attack_type.upper(),
                        ip.src, ip.dst, tcp_packet.dst_port, len(recent)
                    )

            if tcp_packet is not None:
                match_kwargs["tcp_src"] = tcp_packet.src_port
                match_kwargs["tcp_dst"] = tcp_packet.dst_port

            udp_packet = pkt.get_protocol(udp.udp)

            if udp_packet is not None:
                match_kwargs["udp_src"] = udp_packet.src_port
                match_kwargs["udp_dst"] = udp_packet.dst_port

            match = parser.OFPMatch(**match_kwargs)

            # IPv4 flow
            self.add_flow(
                datapath,
                priority=10,
                match=match,
                actions=actions,
                idle_timeout=1
            )

        # -----------------------------------------------------
        # Non-IP / fallback L2 traffic
        # -----------------------------------------------------

        elif ip is None and out_port != ofproto.OFPP_FLOOD:

            match = parser.OFPMatch(
                in_port=in_port,
                eth_src=src,
                eth_dst=dst
            )

            self.add_flow(
                datapath,
                priority=1,
                match=match,
                actions=actions,
                idle_timeout=15
            )

        data = None

        if msg.buffer_id == ofproto.OFP_NO_BUFFER:
            data = msg.data

        out = parser.OFPPacketOut(
            datapath=datapath,
            buffer_id=msg.buffer_id,
            in_port=in_port,
            actions=actions,
            data=data
        )

        datapath.send_msg(out)

    # ---------------------------------------------------------
    # Flow statistics monitor
    # ---------------------------------------------------------

    def _monitor(self):

        while True:

            for datapath in list(self.datapaths.values()):

                self.logger.debug(
                    "FLOW_STATS_REQUEST: requesting stats from dpid=%s",
                    datapath.id
                )

                self._request_flow_stats(datapath)

                # Process mitigation requests generated by IDS
                self._process_block_requests(datapath)

            hub.sleep(2)

    def _request_flow_stats(self, datapath):

        parser = datapath.ofproto_parser

        request = parser.OFPFlowStatsRequest(
            datapath
        )

        datapath.send_msg(request)

    # ---------------------------------------------------------
    # Flow statistics reply
    # ---------------------------------------------------------

    @set_ev_cls(
        ofp_event.EventOFPFlowStatsReply,
        MAIN_DISPATCHER
    )
    def flow_stats_reply_handler(self, ev):

        body = ev.msg.body

        self.logger.debug(
            "FLOW_STATS_REPLY: dpid=%s flows=%d",
            ev.msg.datapath.id,
            len(body)
        )

        for stat in body:

            self.logger.debug(
                "FLOW_STAT_RAW: priority=%s packets=%s bytes=%s match=%s",
                stat.priority,
                stat.packet_count,
                stat.byte_count,
                stat.match
            )

            # Ignore table-miss only after logging it.
            if stat.priority == 0:
                continue

            # Ignore empty flows after logging them.
            if stat.packet_count == 0:
                continue

            flow = self._convert_flow_stat(stat)

            if flow is None:
                # Expected for Ethernet-only flows without IPv4 fields.
                # Genuine conversion exceptions are logged by the converter.
                continue

            # CNN-LSTM-Attention is trained on TCP/UDP flow records.
            # Ignore ICMP/control traffic so unrelated ping flows
            # cannot contaminate the ML sequence.
            if flow.get("protocol") not in (6, 17):
                continue

            flow_key = (
                flow["src_ip"],
                flow["dst_ip"],
                flow["src_port"],
                flow["dst_port"],
                flow["protocol"]
            )

            current_counter = (
                flow["packet_count"],
                flow["byte_count"]
            )

            # Process a flow again only when its packet or byte
            # counters change. Duration alone must not create
            # duplicate temporal ML samples.
            previous_counter = self.processed_flows.get(flow_key)
            self.processed_flows[flow_key] = current_counter

            if previous_counter == current_counter:
                continue

            # Save changed live OpenFlow measurements separately.
            try:
                import csv
                import os

                project_root = os.path.dirname(
                    os.path.dirname(os.path.abspath(__file__))
                )
                output = os.path.join(
                    project_root, "data", "raw",
                    "live_openflow_flows.csv"
                )
                os.makedirs(os.path.dirname(output), exist_ok=True)

                columns = [
                    "timestamp", "src_ip", "dst_ip",
                    "src_port", "dst_port", "protocol",
                    "packet_count", "byte_count",
                    "flow_duration_us", "label"
                ]

                write_header = (
                    not os.path.exists(output)
                    or os.path.getsize(output) == 0
                )

                with open(output, "a", newline="") as dataset:
                    writer = csv.DictWriter(
                        dataset, fieldnames=columns
                    )
                    if write_header:
                        writer.writeheader()

                    writer.writerow({
                        "timestamp": datetime.now().isoformat(
                            timespec="seconds"
                        ),
                        **flow,
                        "label": "Unknown"
                    })

            except Exception as exc:
                self.logger.warning(
                    "Live dataset recording failed: %s", exc
                )

            self._run_detection(flow)

    # ---------------------------------------------------------
    # Convert OpenFlow statistics to IDS flow format
    # ---------------------------------------------------------

    def _convert_flow_stat(self, stat):

        fields = stat.match

        try:
            src_ip = fields.get("ipv4_src")
            dst_ip = fields.get("ipv4_dst")

            if not src_ip or not dst_ip:
                return None

            ip_proto = fields.get("ip_proto", 0)

            src_port = 0
            dst_port = 0

            if ip_proto == 6:
                src_port = fields.get("tcp_src", 0)
                dst_port = fields.get("tcp_dst", 0)

                protocol = 6

            elif ip_proto == 17:
                src_port = fields.get("udp_src", 0)
                dst_port = fields.get("udp_dst", 0)

                protocol = 17

            elif ip_proto == 1:
                protocol = 1

            else:
                protocol = ip_proto

            # Prefer duration reported by OpenFlow statistics.
            # This is switch-entry age, not guaranteed CICFlowMeter
            # session duration, but is a direct switch measurement.
            duration_sec = getattr(stat, "duration_sec", None)
            duration_nsec = getattr(stat, "duration_nsec", 0)

            if duration_sec is not None:
                duration_us = max(
                    0,
                    int(duration_sec) * 1_000_000
                    + int(duration_nsec or 0) // 1_000,
                )
            else:
                # Fallback for stats objects without duration fields.
                if not hasattr(self, "_flow_first_seen"):
                    self._flow_first_seen = {}

                flow_identity = (
                    src_ip, dst_ip, src_port, dst_port, protocol
                )
                now = datetime.now().timestamp()
                first_seen = self._flow_first_seen.setdefault(
                    flow_identity, now
                )
                duration_us = max(
                    0, int((now - first_seen) * 1_000_000)
                )

            return {
                "src_ip": src_ip,
                "dst_ip": dst_ip,
                "src_port": src_port,
                "dst_port": dst_port,
                "protocol": protocol,
                "packet_count": int(stat.packet_count),
                "byte_count": int(stat.byte_count),
                "flow_duration_us": duration_us,
            }

        except Exception as exc:

            self.logger.warning(
                "Unable to convert flow statistics: %s",
                exc
            )

            return None

    # ---------------------------------------------------------
    # Detection
    # ---------------------------------------------------------

    def _run_detection(self, flow):
        """Classify windows of ten distinct flow identities per source."""
        try:
            source_ip = flow.get("src_ip")
            if not source_ip:
                return

            # An OpenFlow statistics update is not necessarily a new flow.
            # Include both endpoint ports so separate connections are distinct.
            flow_identity = (
                source_ip,
                flow.get("src_port"),
                flow.get("dst_ip"),
                flow.get("dst_port"),
                flow.get("protocol"),
            )

            if flow_identity in self.ml_completed_flow_keys:
                return

            # Group the chronological window by source. Repeated statistics
            # updates replace the latest sample for that same flow identity.
            sequence = self.ml_sequences.setdefault(source_ip, {})
            sequence[flow_identity] = dict(flow)

            if len(sequence) < 10:
                self.logger.info(
                    "CNN-LSTM-Attention: collected %d/10 distinct flows "
                    "for source %s",
                    len(sequence),
                    source_ip,
                )
                return

            window_items = list(sequence.items())[-10:]
            model_sequence = []

            for _, item in window_items:
                model_sequence.append([
                    item.get("dst_port", 0),
                    item.get("protocol", 0),
                    item.get("packet_count", 0),
                    item.get("byte_count", 0),
                    item.get("flow_duration_us", 0),
                ])

            # Mark this window as consumed only after prediction succeeds.
            result = self.cnn_lstm_model.predict(model_sequence)

            prediction = result["prediction"]
            confidence = result["confidence"]
            last_flow = window_items[-1][1]
            destination_ip = last_flow.get("dst_ip")

            status = "Normal" if prediction == "Benign" else "Malicious"

            detection = {
                "source_ip": source_ip,
                "destination_ip": destination_ip,
                "src_ip": source_ip,
                "dst_ip": destination_ip,
                "src_port": last_flow.get("src_port"),
                "dst_port": last_flow.get("dst_port"),
                "protocol": last_flow.get("protocol"),
                "packet_count": last_flow.get("packet_count"),
                "byte_count": last_flow.get("byte_count"),
                "flow_duration_us": last_flow.get("flow_duration_us"),
                "attack": prediction,
                "attack_type": prediction,
                "prediction": status,
                "status": status,
                "confidence": round(confidence * 100, 2),
                "probabilities": result["probabilities"],
                "sequence_length": 10,
                "distinct_flow_count": len(window_items),
                "detection_model": "CNN-LSTM-Attention",
                "controller_timestamp": datetime.now().isoformat(),
            }

            self._save_detection(detection)

            self.logger.info(
                "CNN-LSTM-ATTENTION RESULT: %s | %s -> %s | "
                "confidence=%.2f%% | distinct_flows=10",
                prediction,
                source_ip,
                destination_ip,
                confidence * 100,
            )

            # Only the configured attacker addresses are eligible for
            # automatic mitigation through this ML decision path.
            if (
                prediction != "Benign"
                and source_ip == "192.168.100.10"
            ):
                mitigation(prediction, source_ip)
                self.logger.info(
                    "CNN-LSTM-ATTENTION MITIGATION REQUEST: "
                    "source %s",
                    source_ip,
                )

            for identity, _ in window_items:
                self.ml_completed_flow_keys.add(identity)

            self.ml_sequences[source_ip] = {}

        except Exception as exc:
            self.logger.exception(
                "CNN-LSTM-Attention detection failed: %s",
                exc,
            )

    def _save_detection(self, result):
        """Save a detection record using JSON-compatible values."""
        try:
            # Convert NumPy-like values and arrays to JSON-compatible values.
            def make_json_safe(value):
                if hasattr(value, "tolist"):
                    return value.tolist()
                if hasattr(value, "item"):
                    return value.item()
                return str(value)

            safe_result = json.loads(
                json.dumps(result, default=make_json_safe)
            )

            if not safe_result.get("controller_timestamp"):
                safe_result["controller_timestamp"] = datetime.now().isoformat()

            detections = self._read_json(DETECTIONS_FILE, [])
            if not isinstance(detections, list):
                detections = []

            detections.append(safe_result)
            detections = detections[-200:]

            self._write_json(DETECTIONS_FILE, detections)

            self.logger.info(
                "DETECTION SAVED: %s | %s -> %s | time=%s",
                safe_result.get("attack", safe_result.get("attack_type", "Unknown")),
                safe_result.get("source_ip", safe_result.get("src_ip", "Unknown")),
                safe_result.get("destination_ip", safe_result.get("dst_ip", "Unknown")),
                safe_result["controller_timestamp"],
            )

        except Exception:
            self.logger.exception("Failed to save detection record")
            raise

    # ---------------------------------------------------------
    # Apply actual OpenFlow blocking
    # ---------------------------------------------------------

    def _process_block_requests(self, datapath):

        requests = self._read_json(
            BLOCK_REQUEST_FILE,
            []
        )

        if not requests:
            return

        # Apply each block to every currently connected switch.
        connected_datapaths = list(self.datapaths.values())

        if not connected_datapaths:
            return

        blocked_ips = self._read_json(
            BLOCKED_IP_FILE,
            []
        )

        if not isinstance(blocked_ips, list):
            blocked_ips = []

        remaining = []

        for request in requests:
            source_ip = request.get("source_ip")

            if not isinstance(source_ip, str) or not source_ip:
                remaining.append(request)
                continue

            try:
                for switch_datapath in connected_datapaths:
                    parser = switch_datapath.ofproto_parser

                    match = parser.OFPMatch(
                        eth_type=ether_types.ETH_TYPE_IP,
                        ipv4_src=source_ip
                    )

                    self.add_flow(
                        switch_datapath,
                        priority=100,
                        match=match,
                        actions=[],
                        idle_timeout=0,
                        hard_timeout=0
                    )

                    self.logger.warning(
                        "OPENFLOW BLOCK INSTALLED: source=%s dpid=%s",
                        source_ip,
                        switch_datapath.id
                    )

                if source_ip not in blocked_ips:
                    blocked_ips.append(source_ip)

                self._write_json(
                    BLOCKED_IP_FILE,
                    blocked_ips
                )

            except Exception:
                self.logger.exception(
                    "Failed to install block for %s; keeping request pending",
                    source_ip
                )
                remaining.append(request)

        self._write_json(
            BLOCK_REQUEST_FILE,
            remaining
        )


